# MOFENG-RDP 前端镜像（多阶段构建：先 vite 构建，再 nginx 托管）
# 构建（在项目根目录）：docker build -f deploy/Dockerfile.web -t mofeng-rdp-web .

# —— 阶段一：构建前端 ——
FROM node:20-alpine AS build
WORKDIR /build
COPY app/package.json app/package-lock.json* ./
RUN npm install --frozen-lockfile || npm install
COPY app/ ./
# 生产镜像默认注入空字符串：repo.ts 中 fetch(`${REST_BASE}/api/state`) 折叠为相对 '/api/state'，
# 命中阶段二 nginx 的 location /api/ 反代到内网 mofeng-server:8787。
# 切勿注入 '/api'（会形成 /api/api/state 双前缀）；本地 dev 不经本 Dockerfile，保持 8787 直连。
# 可用 --build-arg VITE_API_BASE=http://<host>:8787 覆盖为绝对地址。
# 连带影响：apiV1.ts 共用此变量作 Java /api/v1 基址，注入 '' 后亦变相对路径；
# 按项目口径 Java 属内部联调通道，本镜像对外链路不验证、不宣称其打通。
# 2026-11-26 更正（仅追加，历史注释零改写）：apiV1.ts 已拆分为独立变量
# VITE_API_V1_BASE（默认 http://127.0.0.1:8088），上述「共用变量连带变相对路径」
# 的连带影响已消除；本阶段仍只注入 VITE_API_BASE，Java 通道保持默认基址。
ARG VITE_API_BASE=
ENV VITE_API_BASE=${VITE_API_BASE}
RUN npm run build

# —— 阶段二：nginx 托管 ——
FROM nginx:1.25-alpine
# P0-1：生产配置由模板渲染，网关注入 MOFENG_API_TOKEN（浏览器不持有）
ENV DOLLAR='$'
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# 魔程化解后端环境变量示例（复制为 .env 后按需填写；.env 已被 .gitignore 排除）
# 说明：本后端为「零依赖」设计，实际读取由部署侧注入环境变量；此处仅作配置位声明，不引入 dotenv。

# WorkBuddy 托管智能体（WMA）的调用密钥 —— 严禁写入前端/仓库
CODEBUDDY_API_KEY=

# （可选）Agent 调用端点覆盖，默认 https://api.codebuddy.tencent.com/v1
AI_ENDPOINT=https://api.codebuddy.tencent.com/v1

# 预签名对象下载密钥（已有，此处仅补齐说明）
PRESIGN_SECRET=mofeng-rdp-presign-secret

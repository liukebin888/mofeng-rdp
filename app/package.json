{
  "name": "mofeng-rdp",
  "private": true,
  "version": "1.0.0",
  "description": "魔程化解研发项目管理工具 MOFENG-RDP（依据 SRS V1.4 / 技术方案 V4.0）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "smoke": "node scripts/smoke.cjs",
    "e2e": "node scripts/e2e-click.cjs",
    "probe:compute": "vite-node scripts/probe-compute.mts",
    "probe": "vite-node scripts/probe-compute.mts && node scripts/probe-consistency.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.7",
    "pinia": "^2.3.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright-core": "^1.64.1",
    "typescript": "~5.6.3",
    "vite": "^6.4.5",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  }
}

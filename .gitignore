# 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.local

# 前端构建缓存
.vite/
*.tsbuildinfo

# Java 后端构建产物（阶段 B）
backend/**/target/
*.class

# 运行时数据（审计/状态/存储/任务，不入库）
server/data/

# 环境变量与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 测试覆盖率
coverage/

# 探针运行时产物（数据侧基准与巡检结果，可由 probe 脚本确定性重算）
app/shots/probe-expected.json
app/shots/probe-consistency-result.json

# WorkBuddy 应用发布元数据（本机专属，不入库）
.wbapp_*.genie
.workbuddy/applications.yaml

# 探针截图产物（由 probe 脚本确定性重算）
app/shots/*.png

# 发布产物与打包（不入库，避免大二进制污染）
_site_publish/
*.zip

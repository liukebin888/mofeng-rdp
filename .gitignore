# 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.local

# 前端构建缓存
.vite/
*.tsbuildinfo

# Java 后端构建产物（阶段 B）
backend/**/target/
*.class

# 运行时数据（审计/状态/存储/任务，不入库）
server/data/

# 服务端运行时数据快照备份（不入库）
.workbuddy/backup/

# 环境变量与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 测试覆盖率
coverage/

# 探针运行时产物（数据侧基准与巡检结果，可由 probe 脚本确定性重算）
app/shots/probe-expected.json
app/shots/probe-consistency-result.json

# WorkBuddy 应用发布元数据（本机专属，不入库）
.wbapp_*.genie
.workbuddy/applications.yaml

# 探针截图产物（由 probe 脚本确定性重算）
app/shots/*.png

# QA 临时取证产物（2026-11-25 收口：保留在磁盘供追溯，不入库；含隔离端口/路径硬编码）
# 注：已跟踪的 app/scripts/qa-compute.mts、qa-ui-check.cjs 不受影响（gitignore 只作用于未跟踪文件）
.qa-tmp/
app/scripts/qa-diag-404.cjs
app/scripts/qa-diag-final.cjs
app/scripts/qa-p0-audit-chain.cjs
